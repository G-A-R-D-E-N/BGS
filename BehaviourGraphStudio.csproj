<Project Sdk="Godot.NET.Sdk/4.7.1-double">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>BehaviourStudio</RootNamespace>
  </PropertyGroup>
  <!-- tools/ holds its own projects. Without this the app's default source glob swallows their
       build output and the compiler sees two of every assembly attribute. -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>
</Project>

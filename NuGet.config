<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Godot.NET.Sdk / GodotSharp / GodotSharpEditor / Godot.SourceGenerators resolve from the vendored
    double-precision Godot build under nuget/godot-double-precision/, not the single-precision
    packages on nuget.org. Those 4 packages are versioned "4.7.1-double" so they can never share a
    global package cache slot with the real 4.7.1.

    This tool does not itself need double precision. It matches OpenCommonwealth because the same
    engine binary runs both, and an assembly built against single-precision packages will not load
    in a double-precision build.
  -->
  <packageSources>
    <clear />
    <add key="godot-local-double-precision" value="nuget/godot-double-precision" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

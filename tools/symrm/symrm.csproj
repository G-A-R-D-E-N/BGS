<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>symrm</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>BehaviourStudio.Tools</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Tests.cs" />
    <Compile Include="Png.cs" />
    <Compile Include="GameDefaults.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BehaviourGraph.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Genuine Fallout 4 files used by the end-to-end tests: an np physics skeleton and
         a small turret animation that poses against it. -->
    <None Include="samples/TurretStandingSkeleton.hkx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="samples/TurretIdleWeapReady.hkx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

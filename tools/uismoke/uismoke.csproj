<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BehaviourStudio.UiSmoke</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>uismoke</AssemblyName>
    <StartupObject>BehaviourStudio.UiSmoke.Smoke</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../app/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BehaviourGraph.Core.csproj" />
  </ItemGroup>
</Project>
